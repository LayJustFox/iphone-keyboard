<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="icon_bg">#D1D3D9</color>
    <color name="accent">#007AFF</color>

    <style name="AppTheme" parent="android:Theme.Material.Light.DarkActionBar">
        <item name="android:colorPrimary">#F2F2F7</item>
        <item name="android:colorPrimaryDark">#F2F2F7</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:actionBarStyle">@style/AppBar</item>
    </style>

    <style name="AppBar" parent="android:Widget.Material.Light.ActionBar.Solid">
        <item name="android:background">#F2F2F7</item>
        <item name="android:titleTextStyle">@style/AppBarTitle</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="AppBarTitle" parent="android:TextAppearance.Material.Widget.ActionBar.Title">
        <item name="android:textColor">#000000</item>
    </style>
</resources>
